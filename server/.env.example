# Port the HTTP server listens on
PORT=3000

# --- Database ---
# For production (e.g. Render): set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN to
# a Turso (libSQL) database so data survives restarts/deploys on a host with
# an ephemeral filesystem. Create one free at https://turso.tech, then:
#   turso db create sms-gateway
#   turso db tokens create sms-gateway
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local dev only: used when TURSO_DATABASE_URL is unset. Stores an embedded
# SQLite file on disk - fine for testing, not for production on Render.
DB_PATH=./data/sms-gateway.db

# Comma-separated list of valid API keys for server-to-server / client calls
# (used by POST /api/sms/send, POST /api/devices/register, GET /api/devices)
# Generate strong random values, e.g.: openssl rand -hex 32
API_KEYS=changeme-generate-a-long-random-key

# Rate limiting (requests per window) - tune for your expected traffic
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_API_KEY=60
RATE_LIMIT_MAX_PER_DEVICE_TOKEN=30
